{
  "name": "portfolio-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prefetch": "node scripts/fetch-repos.mjs",
    "dev": "vite",
    "build": "node scripts/fetch-repos.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/.ssr && node scripts/prerender.mjs",
    "build:offline": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/.ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
